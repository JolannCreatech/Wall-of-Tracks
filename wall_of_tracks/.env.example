# Last.fm API key. This is the only secret; keep the real value in .env, never in Git.
# Create one at https://www.last.fm/api/account/create
LASTFM_KEY=your_lastfm_api_key

# Optional. If empty, the app asks for a username in the browser.
LASTFM_USER=your_lastfm_username

# Optional. Published host port for the local site container, and the `npm start` port.
PORT=3001

# Optional. How long recent-listening payloads stay cached, in seconds.
CACHE_TTL_SECONDS=60

# Public hostname used by Caddy in production. No scheme or path.
SITE_ADDRESS=student18.wt.thomasjuldo.com

# Optional. Docker network of the running visit-counter stack.
# VISIT_COUNTER_NETWORK=visit-counter_default
